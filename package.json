{
  "name": "toco-boca-ha",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web && node scripts/build-pwa.js",
    "export:ha": "TOYBOX_BASE_URL=/local/toybox-town expo export --platform web && TOYBOX_BASE_URL=/local/toybox-town node scripts/build-pwa.js",
    "serve": "node scripts/serve.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "idb-keyval": "^6.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
